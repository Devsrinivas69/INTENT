{
  "manifest_version": 3,
  "name": "INTENT DOM Bridge",
  "version": "1.1",
  "description": "INTENT UI guidance DOM element bridge",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://canva.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/*",
        "https://canva.com/*",
        "https://*.canva.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
