{
  "manifest_version": 3,
  "name": "INTENT — Canva DOM Bridge",
  "version": "1.0.0",
  "description": "Provides real physical UI element coordinates from Canva pages to the INTENT desktop guidance system.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://*.canva.com/*",
    "https://www.canva.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.canva.com/*", "https://www.canva.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "INTENT Bridge"
  }
}
