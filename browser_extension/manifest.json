{
  "manifest_version": 3,
  "name": "INTENT DOM Bridge",
  "version": "1.2",
  "description": "INTENT UI guidance DOM element bridge — works on Canva and all Chrome pages",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://canva.com/*",
    "https://*.canva.com/*",
    "https://mail.google.com/*",
    "https://www.youtube.com/*",
    "https://docs.google.com/*",
    "https://sheets.google.com/*",
    "https://slides.google.com/*",
    "https://drive.google.com/*",
    "https://www.google.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/*",
        "https://canva.com/*",
        "https://*.canva.com/*",
        "https://mail.google.com/*",
        "https://www.youtube.com/*",
        "https://docs.google.com/*",
        "https://sheets.google.com/*",
        "https://slides.google.com/*",
        "https://drive.google.com/*",
        "https://www.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
